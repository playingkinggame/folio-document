# ---------- LLM providers (at least one key is required) ----------
# Order = priority. If one fails (rate limit / timeout) the next one answers.
LLM_PROVIDERS=groq,gemini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Comma separated extra Groq models, used as extra fallbacks (limits are per model)
GROQ_EXTRA_MODELS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EXTRA_MODELS=

# ---------- Retrieval ----------
# Local embedding model (runs on CPU via ONNX, no API key). First run downloads it.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# For Hindi / Tamil / mixed-language documents use a multilingual model, e.g.
# EMBEDDING_MODEL=intfloat/multilingual-e5-large   (bigger download, slower)
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_SCORE=0.2

# ---------- Storage ----------
DATA_DIR=./data
# Leave empty to use the embedded local Qdrant folder inside DATA_DIR.
# Set these to use a Qdrant server / Qdrant Cloud instead.
QDRANT_URL=
QDRANT_API_KEY=

# ---------- Access control ----------
# Required: the API rejects protected requests when this is empty.
SUPABASE_URL=
# Leave empty for asymmetric signing keys; legacy HS256 projects only.
SUPABASE_JWT_SECRET=
# Shared secret between the API and the optional voice worker.
APP_SECRET=change-me
MAX_UPLOAD_MB=25

# ---------- Server ----------
# Comma separated origins allowed when the frontend runs on another host (dev: Vite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Voice tutor (LiveKit, optional) ----------
# Create a free project at https://cloud.livekit.io. The same project also powers the
# speech-to-text and text-to-speech through LiveKit Inference.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=multi
TTS_MODEL=inworld/inworld-tts-2
TTS_VOICE=Ashley
ENDPOINTING_MIN_DELAY=0.5
ENDPOINTING_MAX_DELAY=6.0
# Where the voice worker reaches the API (same machine by default).
FOLIO_API_URL=http://127.0.0.1:8000
# Optional. If empty it is derived from APP_SECRET, so just set a strong APP_SECRET.
AGENT_API_KEY=
